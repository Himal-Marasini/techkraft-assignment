NODE_ENV=development
PORT=4041
APP_URL="http://localhost"

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techkraft
# Integration tests only — created and migrated automatically by `pnpm test:e2e`
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techkraft_test

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=replace-me
JWT_EXPIRES_IN=1h

# Password for all seeded demo users (pnpm seed). Pick your own, min 8 chars.
SEED_USER_PASSWORD=change-me-local-only

# docker-compose only (Postgres container credentials and host ports)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=techkraft
POSTGRES_PORT=5432
REDIS_PORT_HOST=6379
